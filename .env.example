# Base URL of the LavaLust API (no trailing slash)
VITE_API_URL=http://localhost/LavaLust-dev-v4/public/index.php/api

# true = local demo data (no backend required)
# false = call the LavaLust API over HTTP
VITE_USE_MOCK=false

# Optional path to a sibling environment file; only DB_* values are inherited.
DB_ENV_FILE=../LavaLust-dev-v4/.env
